#!/bin/sh
# configure - probe the build environment and write config.mk for the Makefile.
#
#   ./configure [--prefix=DIR] [--cc=CMD] [--cflags=...] [--ldlibs=...]
#               [--static-libs] [--help]
#
# Detects a C compiler (CC, then cc/clang/gcc), pthread support and the
# OpenSSL + zlib link flags (pkg-config when available, -lssl -lcrypto -lz
# as the fallback), then writes config.mk. Re-run after changing tools.
# Without arguments the Makefile still works using its built-in defaults;
# configure just pins the probing result so builds are reproducible.

set -e

PREFIX=/usr/local
CC=
CFLAGS="-O2 -Wall -Wextra"
STATIC_LIBS=no

for arg in "$@"; do
  case "$arg" in
    --prefix=*)       PREFIX=${arg#--prefix=} ;;
    --cc=*)           CC=${arg#--cc=} ;;
    --cflags=*)       CFLAGS=${arg#--cflags=} ;;
    --ldlibs=*)       LDLIBS_SET=${arg#--ldlibs=} ;;
    --static-libs)    STATIC_LIBS=yes ;;
    --help|-h)
echo "_   _       _ _"
      echo "| | | |     | | |"
      echo "| | | | ___ | | | ___ _   _"
      echo "| | | |/ _ \\| | |/ _ \\ | | |"
      echo "\\ \\_/ / (_) | | |  __/ |_| |"
      echo " \\___/ \\___/|_|_|\\___|\\__, |"
      echo "                       __/ |"
      echo "                      |___/"
      echo
      echo "usage: $0 [--prefix=DIR] [--cc=CMD] [--cflags=...] [--ldlibs=...] [--static-libs]"
      exit 0 ;;
    *) echo "configure: ignoring unknown option: $arg" >&2 ;;
  esac
done

# --- exe suffix -------------------------------------------------------
EXEEXT=
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) EXEEXT=.exe ;;
esac

echo "_   _       _ _"
echo "| | | |     | | |"
echo "| | | | ___ | | | ___ _   _"
echo "| | | |/ _ \\| | |/ _ \\ | | |"
echo "\\ \\_/ / (_) | | |  __/ |_| |"
echo " \\___/ \\___/|_|_|\\___|\\__, |"
echo "                       __/ |"
echo "                      |___/"
echo
echo "volley configure:"

# 1. pick a compiler -------------------------------------------------
if [ -z "$CC" ]; then
  for c in cc clang gcc; do
    if command -v "$c" >/dev/null 2>&1; then CC=$c; break; fi
  done
fi
if [ -z "$CC" ]; then
  echo "configure: no C compiler found (set --cc= or CC=)" >&2
  exit 1
fi
echo "  compiler     $CC"

probe() {
  printf 'int main(void){return 0;}\n' | "$CC" -x c - -o /dev/null "$@" 2>/dev/null
}

# 2. threads ----------------------------------------------------------
CPTHREAD=-pthread
if ! probe "$CPTHREAD"; then
  CPTHREAD=
  printf 'int main(void){return 0;}\n' | "$CC" -x c - -o /dev/null -lpthread 2>/dev/null \
    && THREAD_LIBS=-lpthread || THREAD_LIBS=
else
  THREAD_LIBS=
fi
echo "  threads      ${CPTHREAD:-none}${THREAD_LIBS:+ +$THREAD_LIBS}"

# 3. OpenSSL + zlib ----------------------------------------------------
if [ -n "$LDLIBS_SET" ]; then
  LDLIBS="$LDLIBS_SET"
elif command -v pkg-config >/dev/null 2>&1 && \
     pkg-config --exists openssl zlib 2>/dev/null; then
  LDLIBS="$(pkg-config --libs openssl zlib)"
  CFLAG_EXTRA="$(pkg-config --cflags openssl zlib)"
  echo "  deps         pkg-config (openssl, zlib)"
else
  LDLIBS="-lssl -lcrypto -lz"
  CFLAG_EXTRA=
  echo "  deps         -lssl -lcrypto -lz (no pkg-config)"
fi
if [ "$STATIC_LIBS" = yes ]; then
  LDLIBS="-Wl,-Bstatic $LDLIBS -Wl,-Bdynamic"
fi
if [ "$THREAD_LIBS" ]; then
  LDLIBS="$LDLIBS $THREAD_LIBS"
fi
if ! probe $CFLAG_EXTRA $LDLIBS; then
  echo "configure: cannot link a program with $LDLIBS (is OpenSSL + zlib installed?)" >&2
  exit 1
fi
echo "  ld libs      $LDLIBS"
echo "  prefix       $PREFIX"
echo "  exe suffix   ${EXEEXT:-none}"

cat > config.mk <<EOF
# config.mk - generated by $0; edit to override, re-run $0 to regenerate.
CC       = $CC
CFLAGS   = $CFLAGS $CFLAG_EXTRA
CPIC     = -fPIC
CPTHREAD = $CPTHREAD
LDLIBS   = $LDLIBS
PREFIX   = $PREFIX
EXEEXT   = $EXEEXT
EOF

echo "wrote config.mk"